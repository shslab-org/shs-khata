<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No Material3 XML theme needed: theme is applied in Compose.
         This base theme provides window background + status bar colors. -->
    <style name="Theme.SHSKhata" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@color/shs_green_dark</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
